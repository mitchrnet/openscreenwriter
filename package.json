{
  "name": "openscreenwriter",
  "version": "1.4.0",
  "description": "Minimalist Fountain screenplay editor with FDX export",
  "main": "main.js",
  "author": "Mitchell Reid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mitchrnet/openscreenwriter.git"
  },
  "homepage": "https://github.com/mitchrnet/openscreenwriter",
  "scripts": {
    "build": "esbuild renderer/editor/index.js --bundle --outfile=renderer/editor.bundle.js --format=esm --platform=browser",
    "dev": "esbuild renderer/editor/index.js --bundle --outfile=renderer/editor.bundle.js --format=esm --platform=browser --watch & electron .",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test tests/e2e/"
  },
  "build": {
    "appId": "com.mitchrnet.openscreenwriter",
    "productName": "OpenScreenwriter",
    "fileAssociations": [
      {
        "ext": "fountain",
        "name": "Fountain Screenplay",
        "description": "Fountain Screenplay File",
        "mimeType": "text/plain",
        "role": "Editor"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.27.3",
    "playwright": "^1.59.1",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.4",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.11.0",
    "prosemirror-view": "^1.41.6",
    "vitest": "^4.1.0"
  }
}
